# Configuración de nube: PostgreSQL en Neon + imágenes en Cloudflare R2 (ADR-11).
# Uso: copiar este archivo a .env (o a .env.nube, que está ignorado por git) y reemplazar los marcadores.
# NUNCA subir a git un archivo con valores reales.

# --- Contenedor db local ---
# Con esta configuración el contenedor db arranca pero la aplicación no lo usa.
# Docker Compose exige estas variables para iniciarlo; sirven valores cualesquiera.
POSTGRES_USER=rocas
POSTGRES_PASSWORD=no_se_usa_en_la_nube
POSTGRES_DB=analisis_rocas

# --- Base de datos: Neon ---
# Panel de Neon > Connect > desactivar "Connection pooling" para obtener la cadena DIRECTA.
# Usar la conexión DIRECTA, no la "pooled" (host con "-pooler"): Alembic y psycopg funcionan sin problemas.
# El prefijo debe ser postgresql+psycopg:// (Neon entrega postgresql://; agregar "+psycopg").
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@HOST-NEON/BASE?sslmode=require

# --- Imágenes: Cloudflare R2 ---
ALMACEN_IMAGENES=s3
# Panel de Cloudflare > R2 > Overview: el ID de cuenta aparece en la URL de la API S3.
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Nombre del bucket privado creado en R2.
S3_BUCKET=NOMBRE-DEL-BUCKET
# R2 > Manage API tokens > Create API token (permiso Object Read & Write sobre el bucket):
# "Access Key ID" y "Secret Access Key". El secreto solo se muestra una vez.
S3_ACCESS_KEY_ID=ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SECRET_ACCESS_KEY
# R2 siempre usa la región "auto".
S3_REGION=auto

RUTA_IMAGENES=/datos/imagenes
RUTA_MODELO=/app/modelos/best.pt
