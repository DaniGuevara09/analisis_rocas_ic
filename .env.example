POSTGRES_USER=rocas
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=analisis_rocas
DATABASE_URL=postgresql+psycopg://rocas:cambiar_esta_clave@db:5432/analisis_rocas
RUTA_IMAGENES=/datos/imagenes
RUTA_MODELO=/app/modelos/best.pt

# Almacén de imágenes: "local" (volumen de Docker) o "s3" (Cloudflare R2, ver .env.nube.example)
ALMACEN_IMAGENES=local
# Solo se usan con ALMACEN_IMAGENES=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
